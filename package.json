{
  "name": "dsh-frontend-page-craft",
  "version": "1.1.0",
  "type": "module",
  "description": "DeepSeek Harness 技能插件：前端页面「需求分析 → 设计 → 实现 → 验收」全流程，内置 32 条前端规范红线检查器（安全/可访问性/Vue 模板/TS/HTML/CSS/性能）与 68 个组件库选型目录。",
  "main": "lib/index.js",
  "bin": {
    "dsh-frontend-standards": "./resources/bin/check-standards.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./standards": "./resources/bin/check-standards.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "resources",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check resources/bin/check-standards.mjs",
    "test": "node test/plugin.test.mjs && node test/standards.test.mjs",
    "standards": "node resources/bin/check-standards.mjs --path . --exclude fixtures",
    "verify": "npm run check && npm test && npm run standards"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "skill",
    "frontend",
    "ui",
    "design-system",
    "component-library",
    "page-design",
    "lint",
    "accessibility",
    "wcag",
    "code-standards",
    "data-visualization"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-0 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lw24-1936/dsh-frontend-page-craft.git"
  },
  "bugs": {
    "url": "https://github.com/lw24-1936/dsh-frontend-page-craft/issues"
  },
  "homepage": "https://github.com/lw24-1936/dsh-frontend-page-craft#readme",
  "license": "MIT"
}
